#!/bin/sh /etc/rc.common
#
# quickstart serves its web UI on a unix socket; the LuCI wrapper
# (luci-app-quickstart) proxies /admin/quickstart to it.
#
START=92
USE_PROCD=1

start_service() {
	mkdir -p /var/run/quickstart
	procd_open_instance
	procd_set_param command /usr/sbin/quickstart serve --unix /var/run/quickstart/local.sock
	procd_set_param respawn
	procd_set_param stderr 1
	procd_close_instance
}
